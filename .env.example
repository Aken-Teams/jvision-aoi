# Run python3 scripts/setup.py to generate .env with unique secrets.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-random-hex
MINIO_ROOT_USER=aoiadmin
MINIO_ROOT_PASSWORD=replace-with-random-hex
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
INSTALL_AI=true
TRAIN_DEVICE=cpu
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLM_BASE_URL=
VLM_ALLOWED_HOSTS=vlm,localhost,127.0.0.1
VLM_MODEL=local-vlm
VLM_API_KEY=local

# Network cameras: exact private IPv4/IPv6 addresses, comma separated
CAMERA_ALLOWED_IPS=
CAMERA_GATEWAY_TOKEN=replace-with-random-hex
CAMERA_GATEWAY_URL=
