  "components": {
    "schemas": {
      "Annotation": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "boxes": {
            "items": {
              "$ref": "#/components/schemas/Box"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Boxes",
            "default": []
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "Annotation"
      },
      "Body_inference_api_v1_inference_post": {
        "properties": {
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "file"
        ],
        "title": "Body_inference_api_v1_inference_post"
      },
      "Body_measurement_api_v1_projects__pid__measure_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "config": {
            "type": "string",
            "title": "Config"
          }
        },
        "type": "object",
        "required": [
          "file",
          "config"
        ],
        "title": "Body_measurement_api_v1_projects__pid__measure_post"
      },
      "Body_upload_api_v1_projects__pid__images_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "OK"
          },
          "group": {
            "type": "string",
            "title": "Group",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_projects__pid__images_post"
      },
      "Box": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "x": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "minimum": 0.0,
            "title": "Y"
          },
          "w": {
